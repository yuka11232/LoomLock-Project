# LoomLock runs fully in demo mode with NO environment variables.
# Everything below is OPTIONAL and only needed if you later wire up Supabase.
# The demo must keep working when these are absent.

# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=server-only-key-never-expose-to-the-browser

# Data source: "demo" (default, localStorage) or "supabase"
# NEXT_PUBLIC_LOOMLOCK_DATA_SOURCE=demo
